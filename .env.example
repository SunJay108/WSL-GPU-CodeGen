# Coder model (llama.cpp)
MODEL_FILE=qwen2.5-coder-7b-instruct-q4_k_m.gguf
GPU_LAYERS=20
# Total context, split across LLAMA_PARALLEL slots (chat + topic classifier).
CTX_SIZE=8192
LLAMA_PARALLEL=2
CPU_THREADS=8

# Qwen3Guard models (./models/Qwen3Guard-Gen-0.6B and ./models/Qwen3Guard-Stream-0.6B)
GUARD_DEVICE=cpu
GUARD_THREADS=4

# First admin account, created on first start when no users exist.
# Leave ADMIN_PASSWORD empty to generate one; it is printed once in `docker compose logs codegen`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Let people create their own (non-admin) accounts on the sign-in page.
ALLOW_SIGNUP=false

# Filter policy
REQUIRE_ENGLISH=true
BLOCK_CONTROVERSIAL=true

# Banned words block a message outright, even a valid coding one. Add them inline
# here (comma-separated) and/or one per line in ./data/banned_words.txt.
BANNED_WORDS=

# Set to true when the UI is served over HTTPS.
COOKIE_SECURE=false
